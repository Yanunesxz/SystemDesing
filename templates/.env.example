# Copie para .env e preencha. O .env NUNCA vai para o Git.
# Apague as linhas dos serviços que este sistema não usa.

# Ambiente: development | production
APP_ENV=development
TZ=America/Sao_Paulo

# Front (Vite): tudo que começa com VITE_ vai para o navegador e qualquer pessoa lê.
# Só o que é público de propósito: a URL do Supabase e a chave anon/publishable.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Só no servidor (Edge Function ou API). NUNCA com prefixo VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# Banco de dados
DATABASE_URL=

# Mercado Livre
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=

# Shopee
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_SHOP_ID=

# WhatsApp Business (Meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# IA
ANTHROPIC_API_KEY=

# Avisos internos (grupo da equipe)
ALERT_WHATSAPP_GROUP_ID=
